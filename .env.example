# Copy this file to `.env` (which is git-ignored) and fill in your keys.
# Loaded automatically by examples/02_switch_providers.py and pytest
# (via sdk-python/tests/conftest.py).

# Postgres connection used by the postgres adapter and by all
# translation adapters running in mock mode.
PG_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Translation-provider credentials. Leave any line blank or commented
# out to skip that provider in the demo / live tests.
MEM0_API_KEY=
SUPERMEMORY_API_KEY=
LETTA_API_KEY=

# Live-mode opt-in (M2.1). MUST be exactly "1" to activate; "true"/"yes"/"0"
# / whitespace keep mock mode. Per-provider granularity: setting just one
# key plus OMP_LIVE=1 activates only that provider.
# OMP_LIVE=1

# Bounded poll budget (seconds) for async providers in get(id). Positive
# integer in (0, 600]; out-of-range / non-numeric falls back to default 60.
# OMP_INGEST_TIMEOUT=60

# Optional overrides
# MEM0_HOST=https://api.mem0.ai
# SUPERMEMORY_BASE_URL=https://api.supermemory.ai/v3
# LETTA_BASE_URL=https://api.letta.com
